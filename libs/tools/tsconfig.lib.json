{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "service-generator/src/generators/service/*.ts"
  ],
  "references": [],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "service-generator/src/generators/service/*.spec.ts",
    "service-generator/src/generators/service/*.test.ts"
  ]
}
