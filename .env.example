# Placeholders only. Never commit a populated .env file.
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Kubernetes can use these fields instead of DATABASE_URL:
# DB_HOST=postgres-host
# DB_PORT=5432
# DB_NAME=ecommerce_dev
# DB_USER=ecommerce_dev
# DB_PASSWORD=REPLACE_WITH_DEV_ONLY_PASSWORD
DEV_WRITE_KEY=REPLACE_WITH_RANDOM_DEV_ONLY_VALUE
JWT_PRIVATE_KEY_PATH=/path/to/test-only-private.pem
JWT_PUBLIC_KEY_PATH=/path/to/test-only-public.pem
# Web server only; run web on port 3001 locally to avoid the API port.
API_INTERNAL_ORIGIN=http://127.0.0.1:3000
