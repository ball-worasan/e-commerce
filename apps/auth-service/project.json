{
  "name": "auth-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/auth-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "prisma-generate": {
      "cache": true,
      "inputs": ["{workspaceRoot}/apps/auth-service/prisma/schema.prisma"],
      "outputs": ["{workspaceRoot}/libs/prisma-client-auth/src/generated"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "prisma generate --schema=apps/auth-service/prisma/schema.prisma"
      }
    },
    "build": {
      "executor": "@nx/webpack:webpack",
      "dependsOn": ["prisma-generate"],
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "apps/auth-service/dist",
        "main": "apps/auth-service/src/main.ts",
        "tsConfig": "apps/auth-service/tsconfig.app.json",
        "assets": ["apps/auth-service/src/assets"],
        "webpackConfig": "apps/auth-service/webpack.config.js"
      },
      "configurations": {
        "development": {
          "outputHashing": "none"
        },
        "production": {}
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ],
      "outputs": [
        "{workspaceRoot}/apps/auth-service/dist/package.json",
        "{workspaceRoot}/apps/auth-service/dist/pnpm-lock.yaml",
        "{workspaceRoot}/apps/auth-service/dist/pnpm-workspace.yaml",
        "{workspaceRoot}/apps/auth-service/dist/patches",
        "{workspaceRoot}/apps/auth-service/dist/local_path_modules"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/apps/auth-service/dist/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "auth-service:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "auth-service:build:development"
        },
        "production": {
          "buildTarget": "auth-service:build:production"
        }
      }
    },
    "test": {
      "dependsOn": ["^build", "prisma-generate"],
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
