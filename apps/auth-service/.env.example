# auth-service environment variables
#
# This file documents every variable auth-service uses, but the values need
# to land in TWO different places, because docker compose and the app itself
# read `.env` from two different locations:
#
#   1. docker compose (the AUTH_DB_* vars below) reads a `.env` file located
#      next to its compose file, i.e. apps/auth-service/.env. Copy this file
#      there before running:
#        cp apps/auth-service/.env.example apps/auth-service/.env
#        docker compose -f apps/auth-service/docker-compose.yml up -d dev
#      (docker-compose.yml also has working defaults for `dev`, so this step
#      is optional unless you want to override credentials/ports.)
#
#   2. The app itself (`pnpm nx serve auth-service`, or the built main.js)
#      loads `.env` via `dotenv/config` in main.ts, which resolves relative
#      to Nx's/node's working directory - the workspace root, not
#      apps/auth-service. Copy this file to the repo root instead:
#        cp apps/auth-service/.env.example .env
#      PORT, DATABASE_URL, JWT_PRIVATE_KEY_PATH and JWT_PUBLIC_KEY_PATH below
#      are required by libs/shared-config's envSchema (no defaults) - without
#      a repo-root .env providing them, `pnpm nx serve auth-service` fails
#      immediately with "Invalid environment configuration".
#
# Never commit the real .env file(s) — they are gitignored.
#
# auth-service owns its own Postgres per environment; these values must
# never be shared with another service's database.

# --- dev ---
AUTH_DB_DEV_USER=postgres
AUTH_DB_DEV_PASSWORD=postgres
AUTH_DB_DEV_NAME=auth
AUTH_DB_DEV_PORT=5433

# --- beta ---
AUTH_DB_BETA_USER=postgres
AUTH_DB_BETA_PASSWORD=changeme
AUTH_DB_BETA_NAME=auth_beta
AUTH_DB_BETA_PORT=5434

# --- prod ---
AUTH_DB_PROD_USER=postgres
AUTH_DB_PROD_PASSWORD=changeme
AUTH_DB_PROD_NAME=auth_prod
AUTH_DB_PROD_PORT=5435

# --- app config (required by libs/shared-config's envSchema, no defaults) ---

# HTTP port the Nest app listens on.
PORT=3000

# DATABASE_URL consumed by Prisma / PrismaService — point it at whichever
# environment you brought up locally. Worked examples for each:
#   dev:  DATABASE_URL=postgresql://postgres:postgres@localhost:5433/auth
#   beta: DATABASE_URL=postgresql://postgres:changeme@localhost:5434/auth_beta
#   prod: DATABASE_URL=postgresql://postgres:changeme@localhost:5435/auth_prod
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/auth

# RS256 key pair used to sign/verify JWTs. These paths are resolved relative
# to the process's working directory when the app boots (the repo root, per
# above). Supply your own local development keys outside Git. Unit tests
# generate test-only keys in memory and do not use these paths.
JWT_PRIVATE_KEY_PATH=secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt-public.pem
