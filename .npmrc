# Prisma's `generate` step invokes `pnpm add @prisma/client@<version>` from
# the workspace root to keep the client package in sync with the `prisma`
# CLI version. This repo intentionally hoists shared runtime deps (including
# @prisma/client) to the workspace root, so allow root-level installs without
# requiring an explicit -w/--workspace-root flag on every such invocation.
ignore-workspace-root-check=true
